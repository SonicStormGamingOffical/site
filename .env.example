# FusionHub site environment variables
# ------------------------------------
# Copy this file to `.env` for local runs:   cp .env.example .env
# On Railway, set these under the service's "Variables" tab instead
# (Railway does not read a .env file from the repo).
#
# `site/server.js` loads `.env` automatically when present; real process
# environment variables always win over the file.

# Port the HTTP server listens on. Railway injects PORT automatically;
# the default (8899) is only used for local runs.
PORT=8899

# Canonical public URL of the site. Used in /api/latest and /health.
SITE_URL=https://replaceme-with-your-site-url.com

# owner/repo whose GitHub releases the server watches for the latest version.
SITE_REPO=replaceme-with-your-github-username/replaceme-with-your-github-repo

# How often to re-check the GitHub release, in milliseconds (min 60000).
SITE_REFRESH_MS=600000

# Optional. GitHub personal access token with `repo` scope. Only required when
# SITE_REPO is private (so the server can read the release) or for
# `node scripts/publish-release.js` uploads. Leave empty when the repo is public.
GH_TOKEN=

# Extension store ------------------------------------------------------------
# Maximum size of an uploaded extension package, in MB.
STORE_MAX_MB=25

# Optional. When set, publishing an extension to the store requires this shared
# secret (sent as the `x-upload-token` header or a `?token=` query parameter).
# Leave empty to allow anyone to publish.
STORE_UPLOAD_TOKEN=

# Telemetry ------------------------------------------------------------------
# Every installed copy of FusionHub Browser silently posts its telemetry here
# (`POST /api/telemetry`, authenticated with the shared token baked into
# build/telemetry.json at build time). Reads come back through
# `GET /api/telemetry` and machines can be removed with `POST /api/forget`.
#
# By default the server accepts the token whose SHA-256 is compiled into
# server.js, so a normal deployment works with no configuration. Set
# FH_TELEMETRY_TOKEN only to rotate to a plaintext secret, or
# FH_TELEMETRY_TOKEN_SHA256 to accept a different hash.
# Data is stored in data/machines.json (git-ignored).
# FH_TELEMETRY_TOKEN=
# FH_TELEMETRY_TOKEN_SHA256=
